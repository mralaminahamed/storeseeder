parameters:
    level: 7

    paths:
        - class-storeseeder.php
        - includes/

    excludePaths:
        # (?) marks a path as optional. node_modules/ and build/ only exist
        # after an install and a build, and PHPStan hard-errors on an excluded
        # path that is missing — which failed the analysis job on a fresh
        # checkout that only installs Composer dependencies.
        - vendor/ (?)
        - node_modules/ (?)
        - build/ (?)
        - tests/
        - languages/

    # WordPress specific configuration
    bootstrapFiles:
        - storeseeder.php

    # Universal object crates
    universalObjectCratesClasses:
        - WP_Post
        - WP_User
        - WP_Term
        - WP_Comment
        - WP_Query
        - WP_REST_Request
        - WP_REST_Response

    # Stub files
    stubFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

    # WP_CLI comes from the WP-CLI runtime, not from WordPress, and it is not autoloadable
    # from here — so it is scanned rather than stubbed. Without it the CLI layer analyses as
    # 47 calls to an unknown class. Dev-only: the commands never run unless WP_CLI is real.
    scanFiles:
        - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
        # The platform drivers write through these plugins' own models. Before the stubs
        # existed, four blanket ignoreErrors patterns hid every FluentCart symbol — which
        # also hid a wrong method name or argument count in a writer, the exact mistake
        # static analysis is for.
        - vendor/mralaminahamed/fluent-cart-stubs/fluent-cart-stubs.stub
        - vendor/mralaminahamed/fluent-cart-stubs/fluent-cart-constants-stubs.stub
        - vendor/mralaminahamed/easycommerce-stubs/easycommerce-stubs.stub
        - vendor/mralaminahamed/easycommerce-stubs/easycommerce-constants-stubs.stub
        - vendor/mralaminahamed/storeengine-stubs/storeengine-stubs.stub
        - vendor/mralaminahamed/storeengine-stubs/storeengine-constants-stubs.stub
        # Pro's classes extend the free plugin's, so it goes after them.
        - vendor/mralaminahamed/fluent-cart-pro-stubs/fluent-cart-pro-stubs.stub
        - vendor/mralaminahamed/fluent-cart-pro-stubs/fluent-cart-pro-constants-stubs.stub

    # WordPress constants
    dynamicConstantNames:
        - ABSPATH
        - WP_DEBUG
        - WP_DEBUG_LOG
        - WP_DEBUG_DISPLAY
        - SCRIPT_DEBUG
        - WP_CACHE
        - STORESEEDER_VERSION
        - STORESEEDER_PLUGIN_FILE
        - STORESEEDER_PLUGIN_URL
        - STORESEEDER_PLUGIN_PATH
    # Ignore errors
    ignoreErrors:
        # WordPress functions that may not be defined during static analysis
        - '#Function wp_[a-zA-Z_]+ not found\.#'
        - '#Function is_plugin_active not found\.#'
        - '#Function get_plugin_data not found\.#'
        - '#Function add_action not found\.#'
        - '#Function add_filter not found\.#'
        - '#Function remove_action not found\.#'
        - '#Function remove_filter not found\.#'
        - '#Function do_action not found\.#'
        - '#Function apply_filters not found\.#'
        - '#Function esc_html not found\.#'
        - '#Function esc_attr not found\.#'
        - '#Function esc_url not found\.#'
        - '#Function sanitize_text_field not found\.#'
        - '#Function wp_die not found\.#'
        - '#Function wp_create_nonce not found\.#'
        - '#Function check_ajax_referer not found\.#'
        - '#Function current_user_can not found\.#'
        - '#Function wp_send_json_success not found\.#'
        - '#Function wp_send_json_error not found\.#'
        - '#Function fluent_cart_[a-zA-Z_]+ not found\.#'

        # PHPUnit specific
        - '#Method [a-zA-Z0-9\\_]+Test::(setUp|tearDown)\(\) should return void but returns [a-zA-Z0-9\\_]+\.#'
        - '#Call to an undefined method PHPUnit\\Framework\\MockObject\\MockObject::[a-zA-Z0-9_]+\(\)\.#'

        # WordPress globals
        - '#Undefined variable: \$wpdb\.#'
        - '#Undefined variable: \$wp_version\.#'
        - '#Undefined variable: \$wp_rest_server\.#'

        # Dynamic properties (WordPress objects often have dynamic properties)
        - '#Access to an undefined property WP_[a-zA-Z_]+::\$[a-zA-Z_]+\.#'
        - '#Property WP_[a-zA-Z_]+::\$[a-zA-Z_]+ \(mixed\) does not accept [a-zA-Z0-9\\_|]+\.#'

        # WordPress hooks (actions and filters)
        - '#Parameter \#1 \$function_to_add of function add_action expects callable\(\): mixed, array given\.#'
        - '#Parameter \#1 \$function_to_add of function add_filter expects callable, array given\.#'


        # mcp-adapter plugin classes (runtime-only dependency, present only when
        # the mcp-adapter plugin is active)
        - '#Class WP\\MCP\\.* not found\.#'

        # The REST namespace is a compile-time constant string and always
        # non-empty; phpstan cannot narrow the property type to non-falsy-string.
        - '#Parameter \#1 \$route_namespace of function register_rest_route expects non-falsy-string, string given\.#'

        # Array type specifications (PHP 7.4 compatibility)
        - '#Method .* has no value type specified in iterable type array\.#'
        - '#Method .* return type has no value type specified in iterable type array\.#'
        - '#Parameter .* has no value type specified in iterable type array\.#'
        - '#has parameter .* with generic class .* but does not specify its types\.#'
        - '#Method .* has parameter .* with no value type specified in iterable type array\.#'
        - '#has parameter \$request with generic class WP_REST_Request but does not specify its types: T#'

        # WordPress specific issues
        - '#Call to function is_numeric\(\) with int will always evaluate to true\.#'
        - '#Variable .* in empty\(\) always exists and is not falsy\.#'
        - '#Call to function is_wp_error\(\) .* will always evaluate to false\.#'
        - '#Strict comparison using .* will always evaluate to true\.#'

        # Faker library dynamic properties
        - '#Access to an undefined property Faker\\Generator::\$[a-zA-Z_]+\.#'

        # Locale-specific FakerPHP formatters. These are provided by the en_US
        # Address provider at runtime and resolve through Generator::__call, but
        # the analysed stub only models the base formatter set. Named one by one
        # so a genuinely misspelled formatter still fails analysis.
        - '#Call to an undefined method Faker\\Generator::stateAbbr\(\)\.#'
        - '#Call to an undefined method Faker\\Generator::state\(\)\.#'
        - '#Call to an undefined method Faker\\Generator::secondaryAddress\(\)\.#'

        # PHPDoc type issues (inheritance)
        - '#PHPDoc tag @return with type .* is not subtype of native type .*\.#'

        # Return type mismatches
        - '#Method .* should return .* but returns false\.#'
        - '#Method .* has invalid return type .*WP_Error\.#'

        # Test-specific ignores
        - '#Instantiated class StoreSeeder\\\\[a-zA-Z_\\\\]+ not found\.#'
        - path: tests/
          message: '#Call to method [a-zA-Z_]+ on an unknown class [a-zA-Z0-9\\_]+\.#'

        - identifier: 'property.notFound'

    # Report unused ignores
    reportUnmatchedIgnoredErrors: false

    # Parallel processing
    parallel:
        jobSize: 20
        maximumNumberOfProcesses: 4

    # Error format
    errorFormat: table

    # Cache
    tmpDir: .phpstan-cache
