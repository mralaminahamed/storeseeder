<?xml version="1.0"?>
<phpunit
        bootstrap="tests/php/bootstrap.php"
        backupGlobals="false"
        colors="true"
        convertErrorsToExceptions="true"
        convertNoticesToExceptions="true"
        convertWarningsToExceptions="true"
        stopOnFailure="false"
        beStrictAboutTestsThatDoNotTestAnything="true"
        beStrictAboutOutputDuringTests="true"
        beStrictAboutTodoAnnotatedTests="true"
        beStrictAboutChangesToGlobalState="true"
        verbose="true"
>
    <php>
        <!-- Path to the test wp-config consumed by wp-phpunit -->
        <env name="WP_PHPUNIT__TESTS_CONFIG" value="tests/php/phpunit-wp-config.php"/>

        <!-- WordPress installation to test against. Leave unset to use the WP
             root above this plugin; CI points it at a downloaded copy. -->
        <!-- <env name="WP_PATH" value="/path/to/wordpress"/> -->

        <!-- Test database. Use a dedicated DB, never the production one: the
             WordPress test suite drops every table sharing the prefix below. -->
        <env name="WP_DB_NAME" value="wordpress_test"/>
        <env name="WP_DB_USER" value="root"/>
        <env name="WP_DB_PASS" value=""/>
        <env name="WP_DB_HOST" value="localhost"/>
        <env name="WP_TABLE_PREFIX" value="storeseeder_test_"/>

        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="E_ALL"/>
    </php>
    <testsuites>
        <testsuite name="unit">
            <directory suffix="Test.php">./tests/php/src</directory>
            <exclude>./tests/php/phpunit-wp-config.php</exclude>
            <exclude>./tests/php/bootstrap.php</exclude>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">./includes</directory>
            <file>./class-storeseeder.php</file>
        </include>
        <exclude>
            <directory>./vendor</directory>
            <directory>./node_modules</directory>
            <directory>./build</directory>
            <directory>./tests</directory>
            <file>./storeseeder.php</file>
        </exclude>
        <report>
            <html outputDirectory="tests/coverage/html"/>
            <clover outputFile="tests/coverage/clover.xml"/>
        </report>
    </coverage>
    <logging>
        <junit outputFile="tests/coverage/junit.xml"/>
    </logging>
</phpunit>