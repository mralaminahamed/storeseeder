msgstr ""

#: includes/MCP/Abilities/Generate_Licenses.php:30
msgid "Generate Licenses"
msgstr ""

#: includes/MCP/Abilities/Generate_Licenses.php:37
msgid "Generate software licences against existing orders — keys, site limits, activation counts and expiry dates, including some already at their activation limit and some expired. On Fluent Cart this requires Fluent Cart Pro, which owns the licensing tables; the request is refused with that reason when it is not active. Requires existing orders and products."
msgstr ""

#: includes/MCP/Abilities/Generate_Licenses.php:46
msgid "Array of generated licence objects with id, license_key, status, order_id, customer_id, site_limit, activation_count and expiration_date."
msgstr ""

