#: includes/MCP/Abilities/Generate_Customers.php:30
msgid "Generate Customers"
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:37
msgid "Generate realistic WordPress customer accounts with billing/shipping addresses, demographic metadata, purchase history, and loyalty tier assignments."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:47
msgid "Customer segments to mix. Allowed: regular, vip, wholesale, guest, returning. A guest holds no account, a wholesale buyer always carries a company, a returning customer has definitely bought something. Default: [\"regular\",\"returning\"]."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:56
msgid "Two-letter country codes to draw addresses from. Default: the sample data's own spread."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:61
msgid "Age groups to draw birth dates from. Allowed: 18-25, 26-35, 36-45, 46-55, 56-65, 65+. A third of customers give no birth date at all."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:69
msgid "Generate a shipping address. False leaves it the same as billing. Default: true."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:74
msgid "Percentage of customers whose shipping address differs from billing (0–100). Default: 30."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:81
msgid "Include phone numbers. Default: true."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:86
msgid "Percentage of customers opted into marketing (0–100). Default: 60."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:93
msgid "Populate lifetime totals, loyalty tier and purchase dates. This is metadata, not orders — use generate-orders for those. Default: true."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:98
msgid "Loyalty tiers to draw from. Where set, the tier is chosen from this list rather than derived from spend. Allowed: bronze, silver, gold, platinum."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:106
msgid "Account status for generated customers. `mixed` spreads across all three. Default: mixed."
msgstr ""

#: includes/MCP/Abilities/Generate_Customers.php:119
msgid "Array of generated customer objects with id, name, email, billing_country, loyalty_tier, total_orders, and total_spent."
msgstr ""

