{
  "name": "mralaminahamed/fluent-cart-fakerpress",
  "description": "Comprehensive Fluent Cart test data generator with 10 specialized generators, real-time validation, advanced parameter configuration, WordPress admin color integration, and modern React Router v7 interface.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Al Amin Ahamed",
      "email": "me@alaminahamed.com",
      "homepage": "https://github.com/mralaminahamed/"
    }
  ],
  "homepage": "https://github.com/mralaminahamed/fluent-cart-fakerpress",
  "support": {
    "issues": "https://github.com/mralaminahamed/fluent-cart-fakerpress/issues",
    "source": "https://github.com/mralaminahamed/fluent-cart-fakerpress"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "fakerphp/faker": "^1.23",
    "bluemmb/faker-picsum-photos-provider": "^2.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.7",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^4.0",
    "php-stubs/wordpress-stubs": "^6.4"
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true
  },
  "autoload": {
    "classmap": [
      "class-fluent-cart-fakerpress.php"
    ],
    "psr-4": {
      "FluentCartFakerPress\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FluentCartFakerPress\\Tests\\": "tests/php/src/"
    }
  },
  "scripts": {
    "phpcs": [
      "Composer\\Config::disableProcessTimeout",
      "phpcs --standard=phpcs.xml"
    ],
    "phpcbf": [
      "Composer\\Config::disableProcessTimeout",
      "phpcbf --standard=phpcs.xml"
    ],
    "phpcs:plugin-review": [
      "Composer\\Config::disableProcessTimeout",
      "phpcs --standard=phpcs.plugin-review.xml"
    ],
    "phpcbf:plugin-review": [
      "Composer\\Config::disableProcessTimeout",
      "phpcbf --standard=phpcs.plugin-review.xml"
    ],
    "phpstan": "phpstan analyse --memory-limit 2G",
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html=tests/coverage/html",
    "makepot": "wp i18n make-pot . languages/fluent-cart-fakerpress.pot --exclude=node_modules,vendor,drafts,docs,build,release,tests",
    "release": [
      "@lint",
      "@analyse",
      "rm -rf release vendor build/*",
      "yarn build",
      "@makepot",
      "mkdir -p release",
      "composer install --no-dev --optimize-autoloader",
      "rsync -av --exclude-from=.distignore . release/fluent-cart-fakerpress/",
      "cd release && zip -r fluent-cart-fakerpress.zip fluent-cart-fakerpress/",
      "composer install"
    ],
    "format": "@phpcbf",
    "lint": "@phpcs",
    "analyse": "@phpstan",
    "fix": "@phpcbf"
  }
}
