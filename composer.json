{
  "name": "mralaminahamed/storeseeder",
  "description": "Comprehensive Fluent Cart test data generator with 17 generators, live preview, schema-driven parameter configuration, WordPress admin colour integration, and a modern React Router v7 interface.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Al Amin Ahamed",
      "email": "alamin.ahamed.dev@gmail.com",
      "homepage": "https://github.com/mralaminahamed/"
    }
  ],
  "homepage": "https://github.com/mralaminahamed/storeseeder",
  "support": {
    "issues": "https://github.com/mralaminahamed/storeseeder/issues",
    "source": "https://github.com/mralaminahamed/storeseeder"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "fakerphp/faker": "^1.23",
    "bluemmb/faker-picsum-photos-provider": "^2.0"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^3.7",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.8",
    "wp-coding-standards/wpcs": "^3.1",
    "yoast/phpunit-polyfills": "^4.0",
    "php-stubs/wordpress-stubs": "^6.4"
  },
  "config": {
    "platform": {
      "php": "7.4"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "optimize-autoloader": true
  },
  "autoload": {
    "classmap": [
      "class-storeseeder.php"
    ],
    "psr-4": {
      "StoreSeeder\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "StoreSeeder\\Tests\\": "tests/php/src/"
    }
  },
  "scripts": {
    "phpcs": [
      "Composer\\Config::disableProcessTimeout",
      "phpcs --standard=phpcs.xml"
    ],
    "phpcbf": [
      "Composer\\Config::disableProcessTimeout",
      "phpcbf --standard=phpcs.xml"
    ],
    "phpcs:plugin-review": [
      "Composer\\Config::disableProcessTimeout",
      "phpcs --standard=phpcs.plugin-review.xml"
    ],
    "phpcbf:plugin-review": [
      "Composer\\Config::disableProcessTimeout",
      "phpcbf --standard=phpcs.plugin-review.xml"
    ],
    "phpstan": "phpstan analyse --memory-limit 2G",
    "test": "phpunit",
    "test:coverage": "phpunit --coverage-html=tests/coverage/html",
    "makepot": [
      "@php -r \"if (! file_exists('build/admin-app.js')) { fwrite(STDERR, 'build/admin-app.js is missing. Run yarn build first: the admin UI strings are extracted from the compiled bundle, because wp i18n make-pot does not read .tsx sources.' . PHP_EOL); exit(1); }\"",
      "wp i18n make-pot . languages/storeseeder.pot --domain=storeseeder --exclude=node_modules,vendor,drafts,docs,release,tests"
    ],
    "release": [
      "@lint",
      "@analyse",
      "rm -rf release vendor build/*",
      "yarn build",
      "@makepot",
      "mkdir -p release",
      "composer install --no-dev --optimize-autoloader",
      "rsync -av --exclude-from=.distignore . release/storeseeder/",
      "cd release && zip -r storeseeder.zip storeseeder/",
      "composer install"
    ],
    "zip:dev": [
      "rm -rf release/dev build/*",
      "yarn build",
      "@makepot",
      "composer update --no-dev",
      "mkdir -p release/dev",
      "rsync -av --exclude='.*' --exclude='node_modules' --exclude='release' --exclude='src' --exclude='docs' --exclude='drafts' --exclude='tests' --exclude='*.md' --exclude='*.log' --exclude='package.json' --exclude='package-lock.json' --exclude='yarn.lock' --exclude='composer.lock' --exclude='webpack.config.js' --exclude='eslint.config.mjs' --exclude='tsconfig.json' --exclude='postcss.config.js' --exclude='tailwind.config.js' --exclude='components.json' --exclude='phpcs.xml' --exclude='phpcs.plugin-review.xml' --exclude='phpstan.neon' --exclude='phpunit.xml.dist' --exclude='phpunit.xml' . release/dev/storeseeder/",
      "cd release/dev && zip -r storeseeder.zip storeseeder/",
      "rm -rf release/dev/storeseeder/",
      "composer install",
      "echo 'Dev zip: release/dev/storeseeder.zip'"
    ],
    "format": "@phpcbf",
    "lint": "@phpcs",
    "analyse": "@phpstan",
    "fix": "@phpcbf"
  }
}
