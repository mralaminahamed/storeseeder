{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=storeseeder",
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "fluent-cart"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "StoreSeeder Demo",
        "blogdescription": "Realistic test data for Fluent Cart stores",
        "permalink_structure": "/%postname%/",
        "posts_per_page": "10",
        "start_of_week": "1"
      }
    },
    {
      "step": "defineWpConfigConsts",
      "consts": {
        "WP_DEBUG": true,
        "WP_DEBUG_LOG": true,
        "WP_DEBUG_DISPLAY": false,
        "SCRIPT_DEBUG": true,
        "WP_MEMORY_LIMIT": "512M"
      }
    }
  ],
  "meta": {
    "title": "StoreSeeder Demo",
    "description": "Generate realistic Fluent Cart test data — 17 generators with live preview, a batch queue, and a modern React admin.",
    "author": "Al Amin Ahamed",
    "categories": [
      "ecommerce",
      "data-generation",
      "testing",
      "development"
    ],
    "difficulty": "beginner"
  }
}
