# Copy to tests/e2e/.env.test and adjust. Values already present in the
# environment win, so CI can set these without touching this file.

# Base URL of the WordPress install to drive. Must have Fluent Cart and
# StoreSeeder active, and the built assets in place (`yarn build`).
WP_BASE_URL=http://localhost:8889

# Administrator used to log in. auth.setup.ts signs in once and reuses the
# session for every spec.
WP_ADMIN_USER=admin
WP_ADMIN_PASS=password
