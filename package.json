{
  "name": "@mralaminahamed/storeseeder",
  "version": "1.0.0",
  "description": "Comprehensive Fluent Cart test data generator with 17 generators, live preview, schema-driven parameter configuration, WordPress admin colour integration, and a modern React Router v7 interface.",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/report",
    "test:e2e:screenshots": "playwright test --config=playwright.screenshots.config.ts --project=shots",
    "test:e2e:banners": "playwright test --config=playwright.screenshots.config.ts --project=banners",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "test:e2e:setup": "bash tests/e2e/setup.sh",
    "packages-update": "wp-scripts packages-update"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "ecommerce",
    "woocommerce",
    "faker",
    "data-generation",
    "react",
    "admin-interface",
    "fake-data",
    "products",
    "customers",
    "orders",
    "coupons"
  ],
  "author": "Al Amin Ahamed <alamin.ahamed.dev@gmail.com> (https://github.com/mralaminahamed/)",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/mralaminahamed/storeseeder",
  "repository": {
    "type": "git",
    "url": "https://github.com/mralaminahamed/storeseeder.git"
  },
  "bugs": {
    "url": "https://github.com/mralaminahamed/storeseeder/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@wordpress/eslint-plugin": "^25.8.0",
    "@wordpress/scripts": "^30.27.0",
    "@wordpress/stylelint-config": "^23.26.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "18",
    "react-dom": "18",
    "sass": "^1.94.0",
    "sass-loader": "^16.0.6",
    "stylelint": "^16.25.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@wordpress/api-fetch": "^7.34.0",
    "@wordpress/dom-ready": "^4.34.0",
    "@wordpress/element": "^6.34.0",
    "@wordpress/html-entities": "^4.34.0",
    "@wordpress/i18n": "^6.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.553.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.4.0"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "packageManager": "yarn@4.18.0"
}
