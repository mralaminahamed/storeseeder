{
  "name": "@mralaminahamed/storeseeder",
  "version": "1.1.0",
  "description": "Test data generator for WordPress e-commerce platforms: 17 platform-neutral generators behind a driver layer, live preview, schema-driven parameter configuration, WordPress admin colour integration, and a modern React Router v7 interface.",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "test:unit:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e/report",
    "test:e2e:screenshots": "playwright test --config=playwright.screenshots.config.ts --project=shots",
    "test:e2e:banners": "playwright test --config=playwright.screenshots.config.ts --project=banners",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "test:e2e:setup": "bash tests/e2e/setup.sh",
    "packages-update": "wp-scripts packages-update"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "ecommerce",
    "woocommerce",
    "faker",
    "data-generation",
    "react",
    "admin-interface",
    "test-data",
    "products",
    "customers",
    "orders",
    "coupons"
  ],
  "author": "Al Amin Ahamed <alamin.ahamed.dev@gmail.com> (https://github.com/mralaminahamed/)",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/mralaminahamed/storeseeder",
  "repository": {
    "type": "git",
    "url": "https://github.com/mralaminahamed/storeseeder.git"
  },
  "bugs": {
    "url": "https://github.com/mralaminahamed/storeseeder/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.11.0",
    "@jest/globals": "^30.4.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@wordpress/eslint-plugin": "^25.8.0",
    "@wordpress/scripts": "^34.0.0",
    "@wordpress/stylelint-config": "^24.1.0",
    "autoprefixer": "^10.5.4",
    "babel-jest": "^30.4.1",
    "eslint": "^9.7.0",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "react": "18",
    "react-dom": "18",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^6.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@wordpress/api-fetch": "^7.52.0",
    "@wordpress/dom-ready": "^4.52.0",
    "@wordpress/element": "^8.4.0",
    "@wordpress/html-entities": "^4.52.0",
    "@wordpress/i18n": "^6.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "packageManager": "yarn@4.18.0"
}
